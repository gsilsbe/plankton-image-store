# Copy this file to .env and edit it:   cp .env.example .env
# .env is ignored by git, so your password never ends up on GitHub.

# First admin account. Created only the first time the app starts with an empty database.
# Changing these later does NOT change the password; use the Users window or manage_users.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Port the web app is served on (http://localhost:8000)
PORT=8000

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# How long a login lasts, in days
SESSION_DAYS=7

# Instrument types offered at upload (comma-separated)
INSTRUMENTS=IFCB,Planktoscope,Flowcam

# Instrument assigned to images stored before instrument types existed
LEGACY_INSTRUMENT=Flowcam

# Metadata columns behind the "Classes" and "Annotation status" dropdowns, and the contributor
CLASS_FIELD=object_annotation_category
STATUS_FIELD=object_annotation_status
PERSON_FIELD=object_annotation_person_name

# Statuses always offered when an annotator changes a status (others found in the data are added)
STATUS_CHOICES=validated,predicted,dubious
